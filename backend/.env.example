# PostgreSQL Database Connection String (Neon pooled connection recommended)
# Use the -pooler hostname from Neon, with pgbouncer=true and connect_timeout=10
# ⚠️ This local file is gitignored. For production, also update DATABASE_URL in
#    Render Dashboard → Environment tab, then redeploy.
DATABASE_URL="postgresql://username:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"

# Server Port (Render/Railway sets this automatically)
PORT=5000

# JWT Secret Key for authenticating API tokens
JWT_SECRET="generate-a-secure-random-string-here"

# CORS allowed origin(s) — comma-separated for multiple
# ⚠️ Must also be set in Render Dashboard → Environment tab
# Example: https://your-frontend.vercel.app
CORS_ORIGIN="*"
